<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- Pins the old netstandard-era compat shims Microsoft.NET.Test.Sdk's transitive
         NETStandard.Library 1.6.1 dependency floors at 4.3.0 to their patched versions
         (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj). -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Archiver.CLI\Archiver.CLI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse Archiver.Core.IntegrationTests' committed 7z/RAR fixtures (tar.exe/libarchive can
         only read, never write, those formats) rather than a third fixture set. -->
    <None Include="..\Archiver.Core.IntegrationTests\Fixtures\valid.7z">
      <Link>Fixtures\valid.7z</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Archiver.Core.IntegrationTests\Fixtures\valid.rar">
      <Link>Fixtures\valid.rar</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- T-F191: reuse Archiver.Core.Tests' own encrypted ZIP fixture (password "testpassword",
         see its MANIFEST.sha256) rather than a third copy — same reuse pattern as valid.7z/rar
         above. -->
    <None Include="..\Archiver.Core.Tests\Fixtures\archives\encrypted_aes256.zip">
      <Link>Fixtures\encrypted_aes256.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- T-F234: cp866 names without the UTF-8 flag, plus 7za's 0x7075 extra. -->
    <None Include="..\Archiver.Core.Tests\Fixtures\archives\legacy_oem866_7za.zip">
      <Link>Fixtures\legacy_oem866_7za.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
