<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- T-F287: [LibraryImport]'s generated marshalling code uses pointers; no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- T-F467: the bsdtar listing model the unit tests run on, checked here against the real tar.exe. -->
  <ItemGroup>
    <Compile Include="..\Archiver.Core.Tests\Services\Sandbox\BsdtarListingModel.cs" Link="BsdtarListingModel.cs" />
    <!-- T-F512 (b): the path matrix generator, run here against the real operations on disk. -->
    <Compile Include="..\Archiver.Core.Tests\PathMatrix\NameShapes.cs" Link="PathMatrix\NameShapes.cs" />
    <Compile Include="..\Archiver.Core.Tests\PathMatrix\PathForms.cs" Link="PathMatrix\PathForms.cs" />
    <Compile Include="..\Archiver.Core.Tests\PathMatrix\AllPairs.cs" Link="PathMatrix\AllPairs.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Archiver.Core\Archiver.Core.csproj" />
  </ItemGroup>

</Project>
