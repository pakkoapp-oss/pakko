<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Lets `dotnet restore` resolve this Windows-targeted TFM on a non-Windows CI runner (e.g.
         GitHub's Automatic Dependency Submission workflow) without NETSDK1100; no effect on an
         actual Windows build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Archiver.Core\Archiver.Core.csproj" />
    <ProjectReference Include="..\Archiver.OperationUi.Protocol\Archiver.OperationUi.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- T-F192: lets Archiver.Shell.Tests unit-test PasswordDialogTemplateBuilder's byte-layout
         logic directly, matching Archiver.Core.csproj's identical InternalsVisibleTo convention
         (see CLAUDE.md) rather than making an implementation-detail class public. -->
    <InternalsVisibleTo Include="Archiver.Shell.Tests" />
  </ItemGroup>
</Project>
