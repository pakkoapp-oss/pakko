<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Archiver.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archiver.App"
    xmlns:viewmodels="using:Archiver.App.ViewModels"
    xmlns:appcore="using:Archiver.App.Core"
    xmlns:tb="using:H.NotifyIcon"
    Title="Archiver">

    <!-- T-F199 step 3: own 32 px title bar (the build stamp lives in it, T-F218/T-F198 item 4), then
         the content: toolbar, table, options, footer. T-F106/T-F224: the table's Star row carries
         the MinHeight on the RowDefinition itself (a child's MinHeight does not grow a Star row),
         and the options scroll instead of forcing a tall window — OptionsScroll's MaxHeight is set
         in code-behind from the space the table's minimum leaves (an Auto row never scrolls).
         The background is a ThemeResource so that it follows a theme change while the window is
         open (T-F327; a brush read from Application.Resources in code stays in the start theme).
         No Mica: dropped when captures came back black (2026-09-28), later traced to the monitor
         being off rather than the backdrop; not re-tested since (DECISIONS.md, wave 4). -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tray icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            LeftClickCommand="{x:Bind TrayLeftClickCommand}"
            ToolTipText="Pakko"
            IconSource="Assets/Square44x44Logo.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayOpenMenuItem" Command="{x:Bind TrayOpenCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="TrayAboutMenuItem" Command="{x:Bind TrayAboutCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="TrayExitMenuItem" Command="{x:Bind TrayExitCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid x:Name="AppTitleBar" Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Padding="12,0,0,0">
            <Image Grid.Column="0" Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" Padding="16,4,16,12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" MinHeight="40"
                  Visibility="{x:Bind ViewModel.IsPendingListVisibility, Mode=OneWay}">
                <Button
                    Grid.Column="0"
                    x:Uid="AddFilesButton"
                    Command="{x:Bind ViewModel.BrowseFilesCommand, Mode=OneWay}"/>
                <Button
                    Grid.Column="1"
                    x:Uid="AddFolderButton"
                    Margin="8,0,0,0"
                    Command="{x:Bind ViewModel.BrowseFolderCommand, Mode=OneWay}"/>
                <Button
                    Grid.Column="3"
                    x:Uid="HashButton"
                    HorizontalAlignment="Right"
                    Command="{x:Bind HashFilesCommand, Mode=OneTime}"/>
                <Button
                    Grid.Column="4"
                    x:Uid="AboutButton"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{x:Bind AboutCommand, Mode=OneTime}"/>
            </Grid>

            <!-- T-F199 step 6: Test (ZIP only, T-F241), Scan, Close archive with Esc (T-F210). -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" MinHeight="40"
                  Visibility="{x:Bind ViewModel.IsBrowsingArchiveVisibility, Mode=OneWay}">
                <Button
                    Grid.Column="1"
                    x:Uid="TestArchiveButton"
                    Command="{x:Bind ViewModel.TestBrowsedArchiveCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TestArchiveVisibility, Mode=OneWay}"/>
                <Button
                    Grid.Column="2"
                    x:Uid="ScanButton"
                    Command="{x:Bind ViewModel.ScanArchiveFromBrowserCommand, Mode=OneWay}"/>
                <Button
                    Grid.Column="3"
                    x:Uid="CloseArchiveButton"
                    Command="{x:Bind ViewModel.CloseArchiveCommand, Mode=OneWay}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    Grid.Column="4"
                    x:Uid="AboutButton"
                    Command="{x:Bind AboutCommand, Mode=OneTime}"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*"
                  Visibility="{x:Bind ViewModel.IsPendingListVisibility, Mode=OneWay}">

                <!-- Header -->
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,80,100,90,140" Margin="12,0,12,0">
                        <Button Grid.Column="0" x:Uid="NameColumnHeader"
                                Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                                CommandParameter="Name"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <FontIcon Grid.Column="0" Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                  HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.7"/>
                        <Button Grid.Column="1" x:Uid="TypeColumnHeader"
                                Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                                CommandParameter="Type"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <FontIcon Grid.Column="1" Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                  HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.7"/>
                        <Button Grid.Column="2" x:Uid="SizeColumnHeader"
                                Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                                CommandParameter="Size"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <FontIcon Grid.Column="2" Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                  HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.7"/>
                        <Button Grid.Column="3" x:Uid="CrcColumnHeader"
                                Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                                CommandParameter="Crc"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <FontIcon Grid.Column="3" Glyph="{x:Bind ViewModel.CrcSortGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                  HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.7"/>
                        <Button Grid.Column="4" x:Uid="ModifiedColumnHeader"
                                Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                                CommandParameter="Modified"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <FontIcon Grid.Column="4" Glyph="{x:Bind ViewModel.ModifiedSortGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                  HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.7"/>
                    </Grid>
                </Border>

                <!-- Body: ListView + empty-state hint overlay in the same cell -->
                <Grid Grid.Row="1">
                    <ListView
                        x:Name="FileListView"
                        ItemsSource="{x:Bind ViewModel.FileItems, Mode=OneWay}"
                        SelectionMode="None"
                        MinHeight="80"
                        AllowDrop="True"
                        DragOver="FileList_DragOver"
                        Drop="FileList_Drop"
                        DoubleTapped="PendingList_DoubleTapped"
                        PreviewKeyDown="PendingList_PreviewKeyDown"
                        ContextRequested="PendingList_ContextRequested">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,4,12,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="appcore:FileItem">
                                <Grid ColumnDefinitions="*,80,100,90,140">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="RemoveMenuItem" Click="RemoveItem_Click"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind FullPath}"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Type}"
                                        TextTrimming="CharacterEllipsis"
                                        Opacity="0.7"/>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Size, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Opacity="0.7"/>
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind Crc32Display, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Opacity="0.7"/>
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind ModifiedDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state (T-F199 board 3): drop zone with its own buttons. It sits over the
                         ListView as a sibling, so it takes drops itself. -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Padding="8"
                        Background="Transparent"
                        AllowDrop="True"
                        DragOver="FileList_DragOver"
                        Drop="FileList_Drop"
                        Visibility="{x:Bind ViewModel.IsFileListEmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="24" Opacity="0.6"/>
                        <TextBlock
                            x:Uid="DropZoneHint"
                            HorizontalAlignment="Center"
                            Opacity="0.8"/>
                        <TextBlock
                            x:Uid="DropZoneModeHint"
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
                            <Button x:Uid="EmptyAddFilesButton" Command="{x:Bind ViewModel.BrowseFilesCommand, Mode=OneWay}"/>
                            <Button x:Uid="EmptyAddFolderButton" Command="{x:Bind ViewModel.BrowseFolderCommand, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*"
                  Visibility="{x:Bind ViewModel.IsBrowsingArchiveVisibility, Mode=OneWay}">

                <Grid x:Name="BrowseBreadcrumbRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <!-- T-F107: up one archive folder level; at the archive root, keeps climbing into
                         real Windows folders (containing folder, drive root, "This PC" drives list) —
                         never exits the browser back to the pending list anymore. Disabled only at
                         "This PC" (MainViewModel.CanNavigateUp), mirroring the destination path row's
                         own drive-root disable pattern. See DECISIONS.md's T-F107 entry. -->
                    <Button
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="8,4,8,4"
                        Command="{x:Bind ViewModel.NavigateUpCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind viewmodels:MainViewModel.BrowseUpButtonName}"
                        AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.BrowseUpButtonName}">
                        <FontIcon Glyph="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <BreadcrumbBar
                        Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.BreadcrumbSegments, Mode=OneWay}"
                        ItemClicked="ArchiveBreadcrumb_ItemClicked"/>
                    <!-- T-F199/T-F202: the weakest method present, read without a password. -->
                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="8,2,8,2"
                        CornerRadius="4"
                        BorderThickness="1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.EncryptionBadgeVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.EncryptionBadgeText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar
                    x:Name="BrowseInfoBar"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsBrowseInfoOpen, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.BrowseInfoSeverity, Mode=OneWay}"
                    Message="{x:Bind ViewModel.BrowseInfoText, Mode=OneWay}"/>

                <Border
                    x:Name="BrowseHeader"
                    Grid.Row="2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,100,100,90,140" Margin="12,0,12,0">
                        <TextBlock Grid.Column="1" x:Uid="BrowseNameColumnHeader" Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" x:Uid="BrowseSizeColumnHeader" Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" x:Uid="PackedColumnHeader" Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" x:Uid="BrowseCrcColumnHeader" Padding="0,6,0,6" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" x:Uid="BrowseModifiedColumnHeader" Padding="0,6,0,6" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <ListView
                    Grid.Row="3"
                    x:Name="ArchiveBrowserListView"
                    ItemsSource="{x:Bind ViewModel.CurrentFolderEntries, Mode=OneWay}"
                    SelectionMode="Multiple"
                    MinHeight="80"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    SelectionChanged="ArchiveBrowserList_SelectionChanged"
                    DoubleTapped="ArchiveBrowserList_DoubleTapped"
                    PreviewKeyDown="ArchiveBrowserList_PreviewKeyDown">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,4,12,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="appcore:ArchiveEntryViewModel">
                            <Grid ColumnDefinitions="Auto,*,100,100,90,140">
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{x:Bind Icon}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Margin="0,0,8,0"
                                    Opacity="0.7"/>
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <!-- T-F199 step 6: an encrypted entry (ZIP only; tar cannot say). -->
                                    <FontIcon
                                        Glyph="&#xE72E;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Margin="0,0,6,0"
                                        Opacity="0.7"
                                        AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.EncryptedEntryIconName}"
                                        Visibility="{x:Bind IsEncrypted}"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind FullPath}"/>
                                </Grid>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind SizeDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    Opacity="0.7"/>
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind CompressedSizeDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    Opacity="0.7"/>
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind CrcDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    Opacity="0.7"/>
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind ModifiedDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    Opacity="0.7"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- T-F199 step 4: two cards, side by side on a wide window and stacked on a narrow one or
                 when "New archive" is collapsed (MainWindow.xaml.cs ArrangeCards, layout only). -->
            <ScrollViewer x:Name="OptionsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Opacity="{x:Bind ViewModel.OptionsOpacity, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.OptionsVisibility, Mode=OneWay}">
                <Grid x:Name="OptionsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- T-F199 board 8: an archives-only list collapses this card; Compress still uses it. -->
                <Expander
                    x:Name="NewArchiveCard"
                    Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Top"
                    AutomationProperties.LabeledBy="{x:Bind NewArchiveCardTitleText}"
                    IsExpanded="{x:Bind ViewModel.IsNewArchiveCardExpanded, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.NewArchiveCardVisibility, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="NewArchiveCardTitleText" x:Uid="NewArchiveCardTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock
                                Text="{x:Bind ViewModel.NewArchiveSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.NewArchiveSummaryVisibility, Mode=OneWay}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="ModeLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <RadioButton
                                x:Uid="OneArchiveRadio"
                                GroupName="ArchiveMode"
                                IsChecked="{x:Bind ViewModel.IsSingleArchive, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                            <RadioButton
                                x:Uid="SeparateArchivesRadio"
                                GroupName="ArchiveMode"
                                IsChecked="{x:Bind ViewModel.IsSeparateArchives, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                        </StackPanel>

                        <TextBlock x:Name="ArchiveNameLabelText" x:Uid="ArchiveNameLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <!-- T-F264: the placeholder is the name Core writes when the box is blank. -->
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            AutomationProperties.LabeledBy="{x:Bind ArchiveNameLabelText}"
                            PlaceholderText="{x:Bind ViewModel.ArchiveNamePlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ArchiveName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind ViewModel.IsArchiveNameAndNotBusy, Mode=OneWay}"/>

                        <TextBlock x:Name="FormatLabelText" x:Uid="FormatLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <ComboBox MinHeight="32" MinWidth="120" SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"
                                      AutomationProperties.LabeledBy="{x:Bind FormatLabelText}"
                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                                <ComboBoxItem x:Uid="FormatZipItem"/>
                                <ComboBoxItem x:Uid="FormatTarItem" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                                <ComboBoxItem x:Uid="FormatTarGzItem" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                                <ComboBoxItem x:Uid="FormatTarBz2Item" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                                <ComboBoxItem x:Uid="FormatTarXzItem" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                                <ComboBoxItem x:Uid="FormatTarZstItem" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                                <ComboBoxItem x:Uid="FormatTarLzmaItem" Visibility="{x:Bind ViewModel.TarFormatVisibility}"/>
                            </ComboBox>
                            <TextBlock x:Name="CompressionLabelText" x:Uid="CompressionLabel" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <ComboBox MinHeight="32" MinWidth="140" SelectedIndex="{x:Bind ViewModel.CompressionLevelIndex, Mode=TwoWay}"
                                      AutomationProperties.LabeledBy="{x:Bind CompressionLabelText}"
                                      IsEnabled="{x:Bind ViewModel.IsCompressionLevelEnabled, Mode=OneWay}">
                                <ComboBoxItem x:Uid="CompressionFastItem"/>
                                <ComboBoxItem x:Uid="CompressionNormalItem"/>
                                <ComboBoxItem x:Uid="CompressionBestItem"/>
                                <ComboBoxItem x:Uid="CompressionNoneItem"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- T-F198 item 5: a tar format says why there is no password. -->
                        <CheckBox
                            x:Uid="EncryptWithPasswordCheck"
                            Grid.Row="3" Grid.Column="1"
                            IsChecked="{x:Bind ViewModel.EncryptWithPassword, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.EncryptCheckVisibility, Mode=OneWay}"/>
                        <TextBlock
                            x:Uid="EncryptZipOnlyNote"
                            Grid.Row="3" Grid.Column="1"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.EncryptZipOnlyVisibility, Mode=OneWay}"/>

                        <!-- T-F199 step 5: the password inline, stacked (a half-width card has no room
                             for two boxes side by side), checked while typing. -->
                        <StackPanel
                            Grid.Row="4" Grid.Column="1"
                            Spacing="6"
                            MaxWidth="420"
                            HorizontalAlignment="Left"
                            Visibility="{x:Bind ViewModel.EncryptionPanelVisibility, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind viewmodels:MainViewModel.EncryptPasswordNote}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                            <PasswordBox
                                x:Name="EncryptPasswordBox"
                                PlaceholderText="{x:Bind viewmodels:MainViewModel.EncryptPasswordPlaceholder}"
                                AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.EncryptPasswordPlaceholder}"
                                PasswordRevealMode="{x:Bind ViewModel.EncryptionPasswordRevealMode, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                PasswordChanged="EncryptPasswordBox_PasswordChanged"/>
                            <PasswordBox
                                x:Name="EncryptConfirmBox"
                                PlaceholderText="{x:Bind viewmodels:MainViewModel.EncryptPasswordConfirmPlaceholder}"
                                AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.EncryptPasswordConfirmPlaceholder}"
                                PasswordRevealMode="{x:Bind ViewModel.EncryptionPasswordRevealMode, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                PasswordChanged="EncryptConfirmBox_PasswordChanged"/>
                            <TextBlock
                                x:Name="EncryptPasswordMessageText"
                                Text="{x:Bind ViewModel.EncryptionPasswordMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.EncryptionPasswordMessageVisibility, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"/>
                            <CheckBox
                                x:Uid="EncryptShowPasswordCheck"
                                IsChecked="{x:Bind ViewModel.ShowEncryptionPassword, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                            <TextBlock
                                Text="{x:Bind viewmodels:MainViewModel.EncryptPasswordRuleHint}"
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>
                </Expander>

                <Border
                    x:Name="DestinationCard"
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="16,12,16,12"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="DestinationCardTitle" Grid.Row="0" Grid.ColumnSpan="2" FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="DestinationLabelText"
                            Grid.Row="1" Grid.Column="0"
                            Text="{x:Bind ViewModel.DestinationLabel, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <!-- Up to parent folder; disabled at a drive root (see
                                 MainViewModel.CanNavigateDestinationUp). -->
                            <Button
                                Grid.Column="0"
                                Padding="8,4,8,4"
                                Command="{x:Bind ViewModel.NavigateDestinationUpCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind viewmodels:MainViewModel.DestinationUpButtonName}"
                                AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.DestinationUpButtonName}">
                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <TextBox
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.DestinationPath, Mode=OneWay}"
                                AutomationProperties.LabeledBy="{x:Bind DestinationLabelText}"
                                IsReadOnly="True"
                                VerticalAlignment="Center"/>
                            <Button
                                Grid.Column="2"
                                Content="..."
                                ToolTipService.ToolTip="{x:Bind viewmodels:MainViewModel.DestinationBrowseButtonName}"
                                AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.DestinationBrowseButtonName}"
                                Command="{x:Bind ViewModel.BrowseDestinationCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                        </Grid>

                        <TextBlock x:Name="ConflictLabelText" x:Uid="ConflictLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" MinHeight="32" MinWidth="200" SelectedIndex="{x:Bind ViewModel.OnConflictIndex, Mode=TwoWay}"
                                  AutomationProperties.LabeledBy="{x:Bind ConflictLabelText}"
                                  IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                            <ComboBoxItem x:Uid="ConflictOverwriteItem"/>
                            <ComboBoxItem x:Uid="ConflictSkipItem"/>
                            <ComboBoxItem x:Uid="ConflictRenameItem"/>
                            <ComboBoxItem x:Uid="ConflictAskItem"/>
                        </ComboBox>

                        <CheckBox
                            x:Uid="OpenDestinationCheck"
                            Grid.Row="3" Grid.Column="1"
                            IsChecked="{x:Bind ViewModel.OpenDestinationFolder, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                        <!-- T-F207: the words say what goes to the Recycle Bin (sources or archives). -->
                        <CheckBox
                            Grid.Row="4" Grid.Column="1"
                            Content="{x:Bind ViewModel.DeleteAfterLabel, Mode=OneWay}"
                            IsChecked="{x:Bind ViewModel.DeleteAfterOperation, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.DeleteAfterVisibility, Mode=OneWay}"/>
                        <TextBlock
                            x:Uid="RecycleBinNote"
                            Grid.Row="5" Grid.Column="1"
                            TextWrapping="Wrap"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.DeleteAfterVisibility, Mode=OneWay}"/>
                        <!-- T-F360: only for an archive that carries the download mark; Group Policy locks it. -->
                        <StackPanel
                            Grid.Row="6" Grid.Column="1"
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.DownloadMarkVisibility, Mode=OneWay}">
                            <CheckBox
                                x:Uid="DownloadMarkCheck"
                                IsChecked="{x:Bind ViewModel.DownloadMarkChecked, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.DownloadMarkCanChange, Mode=OneWay}"/>
                            <TextBlock
                                Text="{x:Bind ViewModel.DownloadMarkNoteText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </ScrollViewer>

            <!-- Footer: status or progress on the left, the action buttons on the right, primary last. -->
            <Grid x:Name="FooterGrid" Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" MinHeight="40"
                  TabFocusNavigation="Local">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <ProgressBar
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                        Maximum="100"
                        IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsOperationRunningVisibility, Mode=OneWay}"/>
                    <!-- T-F211/T-F199 step 7: result, browse selection or preview (App.Core FooterLine);
                         the result stays until the next action. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="4"
                          Visibility="{x:Bind ViewModel.FooterTextVisibility, Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <HyperlinkButton
                            x:Uid="OutcomeShowInFolderButton"
                            Grid.Column="1"
                            TabIndex="0"
                            Padding="4,0"
                            FontSize="12"
                            Command="{x:Bind ViewModel.ShowOutcomeInFolderCommand}"
                            Visibility="{x:Bind ViewModel.ShowOutcomeInFolderVisibility, Mode=OneWay}"/>
                        <HyperlinkButton
                            x:Uid="OutcomeDetailsButton"
                            Grid.Column="2"
                            TabIndex="0"
                            Padding="4,0"
                            FontSize="12"
                            Command="{x:Bind ViewModel.ShowOutcomeDetailsCommand}"
                            Visibility="{x:Bind ViewModel.OutcomeDetailsVisibility, Mode=OneWay}"/>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.StatusLineVisibility, Mode=OneWay}"
                        Opacity="0.7"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button
                    x:Uid="CancelButton"
                    Grid.Column="1"
                    TabIndex="1"
                    AutomationProperties.Name="{x:Bind viewmodels:MainViewModel.CancelButtonName}"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOperationRunningVisibility, Mode=OneWay}"/>

                <Button
                    x:Uid="ClearButton"
                    Grid.Column="2"
                    TabIndex="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPendingListVisibility, Mode=OneWay}"/>
                <!-- T-F199: the primary button is always the rightmost (column 4), the accent on the
                     action that fits the list. T-F212: a disabled Button shows no tooltip, so the
                     reason Extract is off sits on a hit-testable wrapper. -->
                <Border
                    Grid.Column="{x:Bind ViewModel.ExtractButtonColumn, Mode=OneWay}"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ExtractUnavailableHint, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPendingListVisibility, Mode=OneWay}">
                    <Button
                        MinWidth="120"
                        TabIndex="{x:Bind ViewModel.ExtractButtonColumn, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.ExtractUnavailableHint, Mode=OneWay}"
                        Content="{x:Bind ViewModel.ExtractButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ExtractCommand, Mode=OneWay}"
                        Style="{x:Bind ViewModel.ExtractButtonStyle, Mode=OneWay}"/>
                </Border>
                <Button
                    Grid.Column="{x:Bind ViewModel.ArchiveButtonColumn, Mode=OneWay}"
                    TabIndex="{x:Bind ViewModel.ArchiveButtonColumn, Mode=OneWay}"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    Content="{x:Bind ViewModel.ArchiveButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ArchiveCommand, Mode=OneWay}"
                    Style="{x:Bind ViewModel.ArchiveButtonStyle, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPendingListVisibility, Mode=OneWay}"/>

                <Button
                    Grid.Column="3"
                    TabIndex="3"
                    x:Uid="ExtractSelectedButton"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ExtractSelectedFromBrowserCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.BrowseExtractActionsVisibility, Mode=OneWay}"/>
                <Button
                    Grid.Column="4"
                    TabIndex="4"
                    x:Uid="ExtractAllButton"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ExtractAllFromBrowserCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.BrowseExtractActionsVisibility, Mode=OneWay}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
