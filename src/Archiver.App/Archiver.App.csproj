<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Lets `dotnet restore` resolve this Windows-targeted TFM on a non-Windows CI runner (e.g.
         GitHub's Automatic Dependency Submission workflow) without NETSDK1100; no effect on an
         actual Windows build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Archiver.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Square44x44Logo.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!--
      T-F139: the MSIX packaging pipeline's default auto-resource-package split
      (Language|Scale|DXFeatureLevel) tries to carve each locale's resources.pri content out of
      the main package into a separate per-language resource-only package for a .msixbundle, then
      silently fails to actually produce those packages — the shipped package (and bundle, when
      one is produced) ends up with only EN-US, even though every intermediate PRI artifact
      (obj\...\split.language-*.pri) proves all 37 locales were correctly detected. Confirmed on a
      truly clean build (deleted obj/bin/AppPackages first) both locally and via CI-Build-Msix.ps1
      — this is not CI-specific, and it silently regressed every release since resource-package
      splitting first activated (exact trigger unconfirmed - see DECISIONS.md's T-F139 entry).
      Dropping Language from the qualifier list keeps the single package format (matching the
      pre-regression shape) and embeds every locale's resources.pri content inline again, verified
      byte-identical in size to the un-split intermediate resources.pri.
    -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
    <!--
      T-F139 follow-up: without Language-based splitting, resource-package count no longer crosses
      the packaging pipeline's own flat-vs-bundle threshold, so a plain `dotnet publish` now emits
      a flat .msix with the WindowsAppSDK runtime staged as loose sibling files under
      Dependencies\<arch>\Microsoft.WindowsAppRuntime.<version>.msix instead of one self-contained
      .msixbundle. Harmless standalone, but build.yml's release job uploads both x64 and arm64
      artifacts together — the two architectures' identically-named Dependencies files collided as
      GitHub Release assets (HTTP 404 from a duplicate-name upload, first hit on the v1.4.6 tag
      push). Forcing bundle output keeps the single self-contained per-architecture download this
      project's tester releases have always shipped, with every locale still embedded (verified:
      the bundle's one inner package's own <Resources> block lists all 37 languages).
    -->
    <AppxBundle>Always</AppxBundle>
    <Nullable>enable</Nullable>
    <!-- T-F355: Native AOT. CsWinRT's generated marshalling code needs unsafe blocks (without them
         an x:Bind ItemsSource throws under AOT); warning level 2 makes every class that crosses
         the WinRT ABI without being partial a build error. -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.ico" />
  </ItemGroup>

  <!-- T-F368: Deploy.ps1 packages a generated copy carrying the dev revision; the MSIX targets add
       Package.appxmanifest themselves only while @(AppxManifest) is empty. -->
  <ItemGroup Condition="'$(PakkoAppxManifest)' != ''">
    <AppxManifest Include="$(PakkoAppxManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- T-F363: the 2.x metapackage publishes Windows ML's onnxruntime/DirectML DLLs (16 MB); Pakko never calls them. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="native" />
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Archiver.Core\Archiver.Core.csproj" />
    <ProjectReference Include="..\Archiver.App.Core\Archiver.App.Core.csproj" />
    <ProjectReference Include="..\Archiver.Messages\Archiver.Messages.csproj" />
  </ItemGroup>

  <!--
    Declare satellite EXEs as package content so the MSIX packaging pipeline
    picks them up automatically. Conditioned on GenerateAppxPackageOnBuild=true
    so these items are invisible during normal VS Debug/Release builds.
    Satellites must be built before dotnet publish is invoked (Deploy.ps1 step 1).
  -->
  <ItemGroup Condition="'$(GenerateAppxPackageOnBuild)'=='true'">
    <!--
      T-F355: every satellite is Native AOT - one self-contained native exe with the runtime,
      Archiver.Core, its own resources and translations compiled in. Nothing else of it is
      packaged, and there is no .NET runtime at the package root to fall back on.
    -->
    <Content Include="..\Archiver.Shell\bin\$(Platform)\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Archiver.Shell.exe">
      <Link>Archiver.Shell.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- T-F317: pakko.exe (Archiver.CLI) for the "pakko" execution alias. Note the TFM: plain net10.0. -->
    <Content Include="..\Archiver.CLI\bin\$(Platform)\$(Configuration)\net10.0\$(RuntimeIdentifier)\pakko.exe">
      <Link>pakko.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- T-F268 step 4: the Explorer commands' operation window, started by Archiver.Shell.
         Note the TFM: net10.0-windows10.0.17763.0, not Shell's. -->
    <Content Include="..\Archiver.OperationUi\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.17763.0\$(RuntimeIdentifier)\Archiver.OperationUi.exe">
      <Link>Archiver.OperationUi.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Archiver.ShellExtension.dll is a C++ DLL built by MSBuild (Deploy.ps1 step 1b).
      Always reference the Release build — Debug /MTd DLL must never enter an MSIX package.
    -->
    <Content Include="..\Archiver.ShellExtension\bin\$(Platform)\Release\Archiver.ShellExtension.dll"
             Condition="'$(GenerateAppxPackageOnBuild)'=='true'">
      <Link>Archiver.ShellExtension.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Deploy the freshly built MSIX after every Release build in Visual Studio -->
  <Target Name="DeployMsix" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(PAKKO_DEPLOYING)' != '1'">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Deploy.ps1&quot; -DeployOnly" />
  </Target>

  <!-- T-F218: the title's "build" stamp is the compile time, not the MSIX install time that the
       packaged DLL's LastWriteTime reports. -->
  <ItemGroup>
    <AssemblyMetadata Include="PakkoBuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>
</Project>