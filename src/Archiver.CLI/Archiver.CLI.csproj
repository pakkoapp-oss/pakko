<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>pakko</AssemblyName>
    <RootNamespace>Archiver.CLI</RootNamespace>
    <!-- Default only: Publish-Cli.ps1 overrides this with the real vX.Y.Z release tag via
         /p:Version at CI release-build time (see build.yml's build-cli job). Never bump it: every
         other build must not pass for a release (T-F222 - a stale "1.4.2" did), so it stays a
         -dev marker and "pakko -v" adds the commit the SDK appends (CliVersionText). -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Archiver.Core\Archiver.Core.csproj" />
  </ItemGroup>
</Project>
