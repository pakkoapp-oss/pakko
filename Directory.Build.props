<Project>

  <!-- T-F137: surfaces built-in .NET analyzer/code-style diagnostics during a plain `dotnet build`
       for every project in the repo, instead of only as IDE-only suggestions invisible until
       SonarCloud's CI-side run (T-F135/T-F136). -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- T-F150: T-F137 deliberately deferred this ("a blanket flip now would fail the build on
         the next legitimate finding with zero triage time built in") until its live warning count
         was known and small. That triage happened here: the count had already fallen from 17 to 4
         since T-F137 (T-F138/T-F147/T-F148 fixed the rest along the way), and the remaining 4
         (CA1001, CA1716, CA1826, CA1859) were each fixed or suppressed-with-reason (see
         docs/CONVENTIONS.md's "Static-Analysis Won't-Fix Conventions" section and
         docs/DECISIONS.md's T-F150 entry). A `dotnet_diagnostic.*.severity = none` override in
         .editorconfig (CA1305/CA1707/CA1805) is unaffected by this flag — a suppressed diagnostic
         is never emitted, so there's nothing for TreatWarningsAsErrors to promote. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- T-F363: C# 14, set once here; no project overrides it (a test reads the csproj files). -->
    <LangVersion>14</LangVersion>
    <!-- T-F240: the vulnerable-package gate. With TreatWarningsAsErrors above, any known
         advisory (NU1901-NU1904), direct or transitive, fails restore on every CI run and the
         nightly canary. These match the .NET 10 SDK defaults; pinned so an SDK change can't
         quietly relax them. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- T-F364: every project restores from its committed packages.lock.json; CI fails on any
         drift. The canary floats the SDK on purpose (PAKKO_FLOATING_TOOLCHAIN), so it restores
         unlocked and reports the lock diff instead. One RID set for every project, because a
         restore with -r adds that RID's section to each lock in the graph. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(PAKKO_FLOATING_TOOLCHAIN)' != '1'">true</RestoreLockedMode>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
